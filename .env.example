# Copy to backend/.env (read from the directory the server starts in). All optional.

# Where the database and uploaded originals live. Keep it outside the repo.
# MIS_FINANZAS_DATA_DIR=~/.local/share/mis-finanzas

# Bind address. Anything other than localhost needs a login password first
# (`just password`); the server refuses to start otherwise.
# MIS_FINANZAS_HOST=127.0.0.1
# MIS_FINANZAS_PORT=8000

# Hosts the app may download public data from (JSON list).
# MIS_FINANZAS_PUBLIC_HOSTS=["api.argentinadatos.com", "data912.com"]

# Set false to skip the daily MEP and price downloads.
# MIS_FINANZAS_MARKET_REFRESH_ON_STARTUP=true

# Login sessions: days a login lasts; true when served over HTTPS (e.g. `tailscale serve`).
# MIS_FINANZAS_SESSION_DAYS=30
# MIS_FINANZAS_COOKIE_SECURE=false

# Daily backup of the database and uploaded originals into this folder (off when unset).
# MIS_FINANZAS_BACKUP_DIR=/mnt/otro-disco/mis-finanzas
# MIS_FINANZAS_BACKUP_KEEP_DAYS=14
